{
  "name": "host2pro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@vinext/cloudflare": "^1.3.3",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.13",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "wrangler": "^4.159.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "db:migrate": "echo 'Apply migrations/0001_init.sql to D1 (wrangler/cf d1 migrations)'",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply host2pro-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply host2pro-db --remote",
    "secrets:hint": "echo 'Use: npx wrangler secret put NAME --name host2pro'"
  }
}
